# Copy this file to .env only when you want process-level overrides, then
# uncomment the entries you actually use. scripts/run-backend.ps1 loads .env
# without echoing values; a direct `go run .` does not load it automatically.

# Model 1: OpenAI-compatible chat service.
# OPENAI_API_KEY=your-api-key
# OPENAI_MODEL_NAME=your-chat-model-id
# OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1

# Shared model-gateway timeout and optional Volcengine Ark/Doubao provider.
# The Ark adapter uses the Responses API and is hidden as unavailable
# in the model catalog until all three GOPHERAI_ARK_* values are configured.
# GOPHERAI_MODEL_TIMEOUT_SECONDS=90
# GOPHERAI_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# GOPHERAI_ARK_MODEL=doubao-seed-2-0-lite-260428
# GOPHERAI_ARK_API_KEY=your-ark-api-key

# Optional GopherAI configuration overrides. The normal local defaults already
# match docker-compose.yml and the discovered Ollama models.
# GOPHERAI_CONFIG_PATH=C:/absolute/path/to/complete-config.toml
# Set to production (or staging) outside local development. The application
# will then reject development JWT and infrastructure credentials at startup.
# GOPHERAI_ENV=production
# GOPHERAI_APP_HOST=127.0.0.1
# GOPHERAI_APP_PORT=9090
# GOPHERAI_EMAIL=your-name@163.com
# GOPHERAI_EMAIL_AUTHCODE=your-163-authcode
# GOPHERAI_MYSQL_HOST=127.0.0.1
# GOPHERAI_MYSQL_PORT=13306
# GOPHERAI_MYSQL_USER=gopherai
# GOPHERAI_MYSQL_PASSWORD=replace-with-your-password
# GOPHERAI_MYSQL_ROOT_PASSWORD=replace-with-a-separate-root-password
# GOPHERAI_MYSQL_DATABASE=gopherai
# GOPHERAI_REDIS_HOST=127.0.0.1
# GOPHERAI_REDIS_PORT=6379
# GOPHERAI_REDIS_PASSWORD=replace-with-a-strong-redis-password
# GOPHERAI_REDIS_DB=0
# GOPHERAI_RABBITMQ_HOST=127.0.0.1
# GOPHERAI_RABBITMQ_PORT=5672
# GOPHERAI_RABBITMQ_USERNAME=gopherai
# GOPHERAI_RABBITMQ_PASSWORD=replace-with-your-password
# GOPHERAI_RABBITMQ_VHOST=gopherai
# GOPHERAI_RABBITMQ_MANAGEMENT_PORT=15672
# GOPHERAI_JWT_KEY=replace-with-a-long-random-local-key
# GOPHERAI_JWT_EXPIRE_HOURS=24

# Prometheus /metrics is loopback-only unless this token is configured.
# Remote scrapers must send: Authorization: Bearer <this value>.
# GOPHERAI_METRICS_TOKEN=replace-with-a-long-random-metrics-token

# Migration startup policy. API startup defaults to verify in every environment;
# scripts/run-backend.ps1 runs the migration command explicitly for local use.
# Compatibility is a temporary, local-only legacy bridge. Production/staging
# rejects compatibility: run `go run ./cmd/migrate -command up` during release.
# GOPHERAI_ENV=production
# GOPHERAI_DB_MIGRATION_MODE=verify

# Authenticated expensive-operation guard. Defaults shown below use one
# 60-second window, a per-user aggregate quota plus a category quota, and
# process-local in-flight caps shared by chat, voice, RAG, MCP, Agent and image.
# GOPHERAI_COST_GUARD_JSON_MAX_BYTES=1048576
# GOPHERAI_COST_GUARD_WINDOW_SECONDS=60
# GOPHERAI_COST_GUARD_REQUESTS_PER_WINDOW=60
# GOPHERAI_COST_GUARD_CHAT_REQUESTS=20
# GOPHERAI_COST_GUARD_VOICE_REQUESTS=10
# GOPHERAI_COST_GUARD_RAG_REQUESTS=10
# GOPHERAI_COST_GUARD_MCP_REQUESTS=30
# GOPHERAI_COST_GUARD_AGENT_REQUESTS=10
# GOPHERAI_COST_GUARD_IMAGE_REQUESTS=10
# GOPHERAI_COST_GUARD_USER_INFLIGHT=2
# GOPHERAI_COST_GUARD_GLOBAL_INFLIGHT=32
# GOPHERAI_COST_GUARD_IMAGE_INFLIGHT=1
# GOPHERAI_COST_GUARD_RETRY_AFTER_SECONDS=1

# RAG/MCP defaults: local Ollama. A loopback URL does not need a real key.
# GOPHERAI_RAG_BASE_URL=http://127.0.0.1:11434/v1
# GOPHERAI_RAG_EMBEDDING_MODEL=embeddinggemma:latest
# GOPHERAI_RAG_CHAT_MODEL=deepseek-r1:1.5b
# GOPHERAI_RAG_DIMENSION=768
# GOPHERAI_RAG_DOC_DIR=./uploads
# GOPHERAI_RAG_API_KEY=your-rag-api-key
# GOPHERAI_OLLAMA_BASE_URL=http://127.0.0.1:11434
# GOPHERAI_OLLAMA_MODEL=deepseek-r1:1.5b

# Optional Baidu Intelligent Cloud TTS and short-audio ASR.
# GOPHERAI_BAIDU_TTS_API_KEY=your-baidu-api-key
# GOPHERAI_BAIDU_TTS_SECRET_KEY=your-baidu-secret-key
# GOPHERAI_VOICE_ASR_PROVIDER=baidu-batch

# Optional Fish Audio S2 expressive TTS used by the realtime voice path.
# The reference ID must point to a voice that you are authorized to use.
# GOPHERAI_FISH_AUDIO_API_KEY=your-fish-audio-api-key
# GOPHERAI_FISH_AUDIO_BASE_URL=https://api.fish.audio
# GOPHERAI_FISH_AUDIO_MODEL=s2-pro
# GOPHERAI_FISH_AUDIO_REFERENCE_ID=your-authorized-voice-id
# GOPHERAI_VOICE_ALLOWED_ORIGINS=https://app.example.com

# MCP Hub registry. Credentials referenced by the registry remain in their
# own environment variables and must never be written directly into JSON.
# GOPHERAI_MCP_REGISTRY_PATH=config/mcp_servers.json

# Optional image-recognition overrides. scripts/run-backend.ps1 supplies these
# project-relative defaults automatically when ONNX is enabled.
# GOPHERAI_ONNX_MODEL_PATH=models/mobilenetv2/mobilenetv2-7.onnx
# GOPHERAI_ONNX_LABEL_PATH=models/mobilenetv2/synset.txt
# GOPHERAI_ONNX_RUNTIME_PATH=runtime/onnxruntime-win-x64-1.22.0/lib/onnxruntime.dll
