# API 请求前缀。默认值为 /api/v1，也可以配置为完整的跨域地址。
VUE_APP_API_BASE=/api/v1

# 仅供 `npm run serve` 的开发代理使用。
VUE_APP_API_PROXY_TARGET=http://localhost:9090

# Optional fixed realtime voice profile sent by the chat microphone. The
# server accepts only its allowlisted profiles (for example fish-s2-natural,
# fish-s2-warm, fish-s2-empathetic, fish-s2-energetic, or text-only).
VUE_APP_VOICE_PROFILE=fish-s2-natural
